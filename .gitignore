# ── Datasets & large binary files ──────────────────────────────────────────
/data/
*.zip
*.tar.gz
*.tar
*.h5
*.hdf5

# ── Model weights (exclude large ones, allow small best detector checkpoint) ─
results/checkpoints/*.pth
results/checkpoints/*.pt
!results/checkpoints/best.pt
!results/checkpoints/yolov8n_best.pt
*.ckpt

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
*.pyo

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
ENV/
env/

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb~

# ── OS artefacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Logs & caches ────────────────────────────────────────────────────────────
*.log
wandb/
mlruns/
.cache/

